old/
archive/
# Generated TPC-H data (dbgen output).
*.tbl

# tpch-dbgen is fetched on demand by build_tpch.sh (git clone of a pinned
# upstream commit), so the source tree is not committed here.
/tpch-dbgen/
# Same for the skewed (Zipfian) generator used with SKEW=<z>.
/tpch-dbgen-skew/

# Compiled runner binaries (`make` builds run/*.c into bin/).
/bin/

